# Salin ke .env lalu sesuaikan
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Ganti di production! Minimal 32 karakter acak.
JWT_SECRET=lyco-dev-secret-ganti-di-production-min-32-karakter
JWT_EXPIRES_IN=12h

# Akun admin awal (dibuat saat boot pertama atau seed:reset). Password di-hash bcrypt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lyco123

# SQLite file (node:sqlite bawaan Node 22+). Default jika tidak diisi: ./data/lyco.db.
# Gunakan DB_PATH=:memory: hanya untuk DB sementara (mis. test).
# Path relatif mengacu pada folder backend/, bukan working directory.
DB_PATH=./data/lyco.db

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2
